diff --git a/app/src/main/java/me/magnum/melonds/ui/emulator/input/KhMovementStickInputHandler.kt b/app/src/main/java/me/magnum/melonds/ui/emulator/input/KhMovementStickInputHandler.kt
new file mode 100644
index 0000000..afcd898
--- /dev/null
+++ b/app/src/main/java/me/magnum/melonds/ui/emulator/input/KhMovementStickInputHandler.kt
@@ -0,0 +1,76 @@
+package me.magnum.melonds.ui.emulator.input
+
+import android.view.MotionEvent
+import android.view.View
+import me.magnum.melonds.common.vibration.TouchVibrator
+import me.magnum.melonds.domain.model.Input
+import me.magnum.melonds.ui.common.input.KhCameraStickView
+import kotlin.math.sqrt
+
+class KhMovementStickInputHandler(
+    inputListener: IInputListener,
+    enableHapticFeedback: Boolean,
+    touchVibrator: TouchVibrator,
+) : FeedbackInputHandler(inputListener, enableHapticFeedback, touchVibrator) {
+    private var activePointerId = MotionEvent.INVALID_POINTER_ID
+    private var originX = 0f
+    private var originY = 0f
+    private val pressedInputs = mutableSetOf<Input>()
+
+    override fun onTouch(view: View, event: MotionEvent): Boolean {
+        val stickView = view as? KhCameraStickView ?: return false
+        when (event.actionMasked) {
+            MotionEvent.ACTION_DOWN -> {
+                activePointerId = event.getPointerId(0)
+                originX = event.x
+                originY = event.y
+                stickView.beginTouch(originX, originY)
+                performHapticFeedback(view, HapticFeedbackType.KEY_PRESS)
+            }
+            MotionEvent.ACTION_MOVE -> {
+                val index = event.findPointerIndex(activePointerId)
+                if (index >= 0) updateMovement(stickView, event.getX(index), event.getY(index))
+            }
+            MotionEvent.ACTION_POINTER_UP -> if (event.getPointerId(event.actionIndex) == activePointerId) reset(stickView)
+            MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL -> reset(stickView)
+        }
+        return true
+    }
+
+    private fun updateMovement(view: KhCameraStickView, touchX: Float, touchY: Float) {
+        val radius = (minOf(view.width, view.height) * 0.28f).coerceAtLeast(1f)
+        var x = (touchX - originX) / radius
+        var y = (touchY - originY) / radius
+        val magnitude = sqrt(x * x + y * y)
+        if (magnitude > 1f) {
+            x /= magnitude
+            y /= magnitude
+        }
+        view.setStickPosition(x, y)
+
+        val wanted = mutableSetOf<Input>()
+        if (magnitude >= DEADZONE) {
+            if (x <= -DIRECTION_THRESHOLD) wanted.add(Input.LEFT)
+            if (x >= DIRECTION_THRESHOLD) wanted.add(Input.RIGHT)
+            if (y <= -DIRECTION_THRESHOLD) wanted.add(Input.UP)
+            if (y >= DIRECTION_THRESHOLD) wanted.add(Input.DOWN)
+        }
+
+        pressedInputs.filterNot { it in wanted }.forEach(inputListener::onKeyReleased)
+        wanted.filterNot { it in pressedInputs }.forEach(inputListener::onKeyPress)
+        pressedInputs.clear()
+        pressedInputs.addAll(wanted)
+    }
+
+    private fun reset(view: KhCameraStickView) {
+        pressedInputs.forEach(inputListener::onKeyReleased)
+        pressedInputs.clear()
+        activePointerId = MotionEvent.INVALID_POINTER_ID
+        view.endTouch()
+    }
+
+    private companion object {
+        const val DEADZONE = 0.18f
+        const val DIRECTION_THRESHOLD = 0.30f
+    }
+}

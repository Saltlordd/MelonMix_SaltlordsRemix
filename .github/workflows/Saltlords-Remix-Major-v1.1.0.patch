+@Composable
+fun RemixGuideUi(firstLaunch: Boolean, whatsNew: Boolean = false, onDismiss: () -> Unit) {
+    Dialog(
+        onDismissRequest = { if (!firstLaunch) onDismiss() },
+        properties = DialogProperties(usePlatformDefaultWidth = false),
+    ) {
+        Surface(color = MaterialTheme.colors.background, modifier = Modifier.fillMaxSize()) {
+            Column(modifier = Modifier.fillMaxSize()) {
+                Column(
+                    modifier = Modifier.weight(1f).verticalScroll(rememberScrollState())
+                        .padding(horizontal = 24.dp, vertical = 28.dp),
+                    verticalArrangement = Arrangement.spacedBy(16.dp),
+                ) {
+                    Text(
+                        if (whatsNew) "What’s new in Saltlord’s Remix" else "Melon Mix: Saltlord’s Remix",
+                        style = MaterialTheme.typography.h5,
+                        fontWeight = FontWeight.Bold,
+                    )
+                    if (whatsNew) {
+                        GuideSection("Cinematic & launcher polish", listOf(
+                            "Choose regular or reverse landscape for HD cinematics",
+                            "Place and resize the cinematic Rotate control in the layout editor",
+                            "A refreshed launcher-icon identity that prompts Android launchers to reload the Remix artwork",
+                        ))
+                    }
+                    Text(
+                        "A human-directed, Android-focused fork built to make the Kingdom Hearts Nintendo DS games feel at home on modern touch devices.",
+                        style = MaterialTheme.typography.body1,
+                    )
+                    GuideSection("What’s different in Remix?", listOf(
+                        "A dedicated, editable KH touchscreen preset",
+                        "Relative movement and camera controls designed for touch",
+                        "Touch Lock-On, Shortcut hold, command, map and HUD controls",
+                        "Context-sensitive controls with manual and timed auto-hide",
+                        "Controller-aware touchscreen visibility",
+                        "Per-control positioning, sizing and opacity with grid snapping",
+                        "Portrait 4:3, landscape 4:3 and fullscreen landscape launch profiles",
+                        "Foldable-aware layouts and custom viewport positioning",
+                        "HD cinematics with optional landscape preference, manual rotation and gameplay-orientation restoration",
+                        "Saltlord’s Remix launcher icon and red, black and warm-gold visual identity",
+                    ))
+                    GuideSection("Display profiles", listOf(
+                        "Automatic — follows the current device configuration and is the only profile with tabletop/posture support.",
+                        "Portrait · 4:3 — locks portrait orientation and preserves the configured portrait screen position.",
+                        "Landscape · 4:3 — locks landscape with a proportionally correct 4:3 game view.",
+                        "Landscape · Fullscreen — locks landscape and uses the full safe display width, including ultra-wide displays.",
+                    ))
+                    GuideSection("Known bugs & limitations", listOf(
+                        "Automatic posture or orientation changes can stretch 3D graphics until the game is restarted.",
+                        "HD cinematics are not currently constrained to a foldable’s tabletop upper panel.",
+                        "Some compatibility limitations are inherited from KH Melon Mix, MelonMix Android and melonDS rather than introduced by Remix.",
+                    ))
+                    GuideSection("Credits & development", listOf(
+                        "Built upon KH Melon Mix, MelonMix Android, melonDS Android and melonDS.",
+                        "AI assistance has supported research, implementation and debugging under human direction. Upstream attribution remains essential, and useful bug reports are welcome.",
+                    ))
+                    Divider()
+                    Text(
+                        "Build ${BuildConfig.VERSION_NAME} · ${BuildConfig.REMIX_SOURCE_COMMIT}",
+                        style = MaterialTheme.typography.caption,
+                        color = MaterialTheme.colors.onBackground,
+                    )
+                }
+                Row(
+                    modifier = Modifier.fillMaxWidth().padding(16.dp),
+                    horizontalArrangement = Arrangement.End,
+                ) {
+                    if (firstLaunch) {
+                        Button(
+                            onClick = onDismiss,
+                            colors = ButtonDefaults.buttonColors(backgroundColor = MaterialTheme.colors.secondary),
+                        ) { Text("Get started", fontSize = 16.sp) }
+                    } else {
+                        TextButton(onClick = onDismiss) { Text("Close") }
+                    }
+                }
+            }
+        }
+    }
+}
+
+@Composable
+private fun GuideSection(title: String, entries: List<String>) {
+    Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
+        Text(title, style = MaterialTheme.typography.h6, fontWeight = FontWeight.SemiBold)
+        entries.forEach { entry ->
+            Row(modifier = Modifier.fillMaxWidth()) {
+                Text("•", modifier = Modifier.padding(end = 8.dp))
+                Text(entry, style = MaterialTheme.typography.body2)
+            }
+        }
+        Spacer(Modifier.height(2.dp))
+    }
+}

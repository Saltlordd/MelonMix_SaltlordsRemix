+++ b/app/src/main/java/me/magnum/melonds/ui/emulator/input/KhCameraStickInputHandler.kt
@@ -0,0 +1,70 @@
+package me.magnum.melonds.ui.emulator.input
+
+import android.view.MotionEvent
+import android.view.View
+import me.magnum.melonds.MelonEmulator
+import me.magnum.melonds.common.vibration.TouchVibrator
+import me.magnum.melonds.ui.common.input.KhCameraStickView
+import kotlin.math.sqrt
+
+class KhCameraStickInputHandler(
+    private val enableHapticFeedback: Boolean,
+    private val touchVibrator: TouchVibrator,
+) : View.OnTouchListener {
+    private var activePointerId = MotionEvent.INVALID_POINTER_ID
+
+    override fun onTouch(view: View, event: MotionEvent): Boolean {
+        val stickView = view as? KhCameraStickView ?: return false
+
+        when (event.actionMasked) {
+            MotionEvent.ACTION_DOWN -> {
+                activePointerId = event.getPointerId(0)
+                if (enableHapticFeedback) touchVibrator.performTouchHapticFeedback()
+                updateCamera(stickView, event.x, event.y)
+            }
+            MotionEvent.ACTION_MOVE -> {
+                val pointerIndex = event.findPointerIndex(activePointerId)
+                if (pointerIndex >= 0) {
+                    updateCamera(stickView, event.getX(pointerIndex), event.getY(pointerIndex))
+                }
+            }
+            MotionEvent.ACTION_POINTER_UP -> {
+                if (event.getPointerId(event.actionIndex) == activePointerId) resetCamera(stickView)
+            }
+            MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL -> resetCamera(stickView)
+        }
+        return true
+    }
+
+    private fun updateCamera(view: KhCameraStickView, touchX: Float, touchY: Float) {
+        val radius = (minOf(view.width, view.height) * 0.28f).coerceAtLeast(1f)
+        var x = (touchX - view.width / 2f) / radius
+        var y = (touchY - view.height / 2f) / radius
+        val magnitude = sqrt(x * x + y * y)
+
+        if (magnitude > 1f) {
+            x /= magnitude
+            y /= magnitude
+        } else if (magnitude < DEADZONE) {
+            x = 0f
+            y = 0f
+        } else {
+            val scaledMagnitude = (magnitude - DEADZONE) / (1f - DEADZONE)
+            x = x / magnitude * scaledMagnitude
+            y = y / magnitude * scaledMagnitude
+        }
+
+        view.setStickPosition(x, y)
+        MelonEmulator.setKhCameraAxes(x, y)
+    }
+
+    private fun resetCamera(view: KhCameraStickView) {
+        activePointerId = MotionEvent.INVALID_POINTER_ID
+        view.setStickPosition(0f, 0f)
+        MelonEmulator.setKhCameraAxes(0f, 0f)
+    }
+
+    private companion object {
+        const val DEADZONE = 0.12f
+    }
+}

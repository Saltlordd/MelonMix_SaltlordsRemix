+    private fun loadBundledKhBackground(variant: UILayoutVariant): RuntimeBackground {
+        val width = variant.uiSize.x
+        val height = variant.uiSize.y
+        val portrait = height > width
+        val shortToLongRatio = minOf(width, height) / maxOf(width, height).toFloat()
+        val unfolded = variant.folds.isNotEmpty() || shortToLongRatio >= 0.70f
+        val drawableId = when {
+            unfolded && portrait -> R.drawable.kh_bg_unfolded_portrait
+            unfolded -> R.drawable.kh_bg_unfolded_landscape
+            portrait -> R.drawable.kh_bg_folded_portrait
+            else -> R.drawable.kh_bg_folded_landscape
+        }
+        val uri = Uri.parse("android.resource://${BuildConfig.APPLICATION_ID}/$drawableId")
+        return RuntimeBackground(Background(null, "KHDS: TOUCH REMIX", uri), BackgroundMode.FILL_CENTER)
+    }

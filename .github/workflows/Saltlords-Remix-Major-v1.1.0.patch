+package me.magnum.melonds.ui.common.input
+
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import android.graphics.Path
+import android.graphics.Typeface
+import android.view.View
+import kotlin.math.min
+
+class KhShortcutToggleView(context: Context) : View(context) {
+    private val backgroundPaint = Paint(Paint.ANTI_ALIAS_FLAG)
+    private val ringPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+        color = Color.WHITE
+        style = Paint.Style.STROKE
+        strokeWidth = resources.displayMetrics.density * 2f
+    }
+    private val labelPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+        color = Color.WHITE
+        textAlign = Paint.Align.CENTER
+        typeface = Typeface.DEFAULT_BOLD
+    }
+    private val heartPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+        color = Color.WHITE
+        style = Paint.Style.FILL
+    }
+    private val heartPath = Path()
+
+    var isLatched = false
+        private set
+
+    fun setLatched(latched: Boolean) {
+        isLatched = latched
+        invalidate()
+    }
+
+    override fun onDraw(canvas: Canvas) {
+        super.onDraw(canvas)
+        val size = min(width, height).toFloat()
+        val centerX = width / 2f
+        val centerY = height / 2f
+        val radius = size * 0.46f
+
+        backgroundPaint.color = if (isLatched) Color.argb(205, 30, 125, 255) else Color.argb(135, 0, 0, 0)
+        canvas.drawCircle(centerX, centerY, radius, backgroundPaint)
+        canvas.drawCircle(centerX, centerY, radius, ringPaint)
+
+        heartPath.reset()
+        heartPath.moveTo(centerX, centerY + size * 0.20f)
+        heartPath.cubicTo(centerX - size * 0.40f, centerY - size * 0.02f, centerX - size * 0.27f, centerY - size * 0.32f, centerX, centerY - size * 0.12f)
+        heartPath.cubicTo(centerX + size * 0.27f, centerY - size * 0.32f, centerX + size * 0.40f, centerY - size * 0.02f, centerX, centerY + size * 0.20f)
+        heartPath.close()
+        canvas.drawPath(heartPath, heartPaint)
+        labelPaint.textSize = size * 0.105f
+        canvas.drawText(if (isLatched) "SHORTCUT ON" else "SHORTCUT", centerX, centerY + size * 0.34f, labelPaint)
+    }
+}

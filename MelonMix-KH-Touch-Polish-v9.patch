+package me.magnum.melonds.ui.common.input
+
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import android.view.View
+
+/** A transparent touch surface that only draws its relative joystick while held. */
+class KhCameraSwipeZoneView(context: Context) : View(context) {
+    private val basePaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+        color = Color.argb(75, 20, 20, 20)
+        style = Paint.Style.FILL
+    }
+    private val ringPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+        color = Color.argb(115, 255, 255, 255)
+        style = Paint.Style.STROKE
+        strokeWidth = resources.displayMetrics.density * 1.5f
+    }
+    private val knobPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+        color = Color.argb(135, 255, 255, 255)
+        style = Paint.Style.FILL
+    }
+
+    private var originX = 0f
+    private var originY = 0f
+    private var axisX = 0f
+    private var axisY = 0f
+    private var radius = 1f
+    private var active = false
+
+    fun beginTouch(x: Float, y: Float, radius: Float) {
+        originX = x
+        originY = y
+        this.radius = radius.coerceAtLeast(1f)
+        active = true
+        setStickPosition(0f, 0f)
+    }
+
+    fun setStickPosition(x: Float, y: Float) {
+        axisX = x.coerceIn(-1f, 1f)
+        axisY = y.coerceIn(-1f, 1f)
+        invalidate()
+    }
+
+    fun endTouch() {
+        active = false
+        setStickPosition(0f, 0f)
+    }
+
+    override fun onDraw(canvas: Canvas) {
+        super.onDraw(canvas)
+        if (!active) return
+
+        val knobRadius = radius * 0.32f
+        canvas.drawCircle(originX, originY, radius, basePaint)
+        canvas.drawCircle(originX, originY, radius, ringPaint)
+        canvas.drawCircle(
+            originX + axisX * (radius - knobRadius),
+            originY + axisY * (radius - knobRadius),
+            knobRadius,
+            knobPaint,
+        )
+    }
+}

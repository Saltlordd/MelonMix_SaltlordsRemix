diff --git a/app/src/main/cpp/MelonInstance.cpp b/app/src/main/cpp/MelonInstance.cpp
index 68178ed..3717c50 100644
--- a/app/src/main/cpp/MelonInstance.cpp
+++ b/app/src/main/cpp/MelonInstance.cpp
@@ -439,6 +439,14 @@ u32 MelonInstance::runFrame()
         plugin->refreshGameScene();
         plugin->buildShapes();
 
+        const bool hideSceneControls = plugin->shouldHideNonessentialTouchControls();
+        if (hideSceneControls != khSceneControlsHidden)
+        {
+            khSceneControlsHidden = hideSceneControls;
+            int32_t hidden = hideSceneControls ? 1 : 0;
+            fireEmulatorEvent(AndroidMelonEventMessenger::EVENT_KH_SCENE_CONTROLS, sizeof(hidden), &hidden);
+        }
+
         // [KHMM] Per-frame plugin input processing, in desktop order (EmuThread.cpp:324-336):
         // camera touch-key mask first, then the hotkey hook, then the KH addon keys, then
         // the filtered mask reaches the DS. Runs on a COPY of inputMask so the raw user
@@ -1296,4 +1304,4 @@ void MelonInstance::saveRewindState(RewindSaveState* rewindSaveState)
     delete savestate;
 }
 
-}
\ No newline at end of file
+}

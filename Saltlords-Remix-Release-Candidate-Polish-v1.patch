+import me.magnum.melonds.R
+
+/** Optional, resumable setup. The Android picker is launched only by an explicit tap. */
+@Composable
+fun RemixSetupUi(
+    step: Int,
+    onNext: () -> Unit,
+    onSkip: () -> Unit,
+    onRequestFileAccess: () -> Unit,
+    onChooseRomFolder: () -> Unit,
+    onChooseModFolder: () -> Unit,
+    onChooseDisplay: () -> Unit,
+    onChooseGraphics: () -> Unit,
+) {
+    val titles = listOf("File access", "Your Kingdom Hearts games", "Optional Remix assets", "Display layout", "Graphics")
+    val descriptions = listOf(
+        "You’ll choose your ROM folder separately. HD videos and mods use MelonMix’s native assets folder, which requires Android’s all-files access on recent devices. Android will ask only when you press Grant file access.",
+        "Choose a ROM folder. The library recognises 358/2 Days and Re:Coded across US, EU and JP releases. You can do this later if your games are not ready yet.",
+        "Choose the MelonMix folder containing your optional assets/ subfolder. HD cinematics and remastered music work when their packs are present. You can skip this step.",
+        "Choose how newly added games start. You can still set a different display profile for each game later.",
+        "Choose Low-Spec, Balanced, High-Spec or Custom. Every graphics setting remains editable later.",
+    )
+    val actions = listOf("Grant file access", "Choose ROM folder", "Choose mod folder", "Choose display layout", "Choose graphics preset")
+    val callbacks = listOf(onRequestFileAccess, onChooseRomFolder, onChooseModFolder, onChooseDisplay, onChooseGraphics)
+    Dialog(onDismissRequest = {}, properties = DialogProperties(usePlatformDefaultWidth = false)) {
+        Surface(color = MaterialTheme.colors.background, modifier = Modifier.fillMaxSize()) {
+            Column(modifier = Modifier.fillMaxSize().padding(24.dp), verticalArrangement = Arrangement.spacedBy(16.dp)) {
+                Image(
+                    painter = painterResource(R.drawable.kh_remix_final_logo),
+                    contentDescription = "Melon Mix: Saltlord’s Remix",
+                    contentScale = ContentScale.Fit,
+                    modifier = Modifier.fillMaxWidth().height(120.dp).sizeIn(maxWidth = 360.dp),
+                )
+                Text("Setup ${step + 1} of 5", style = MaterialTheme.typography.caption)
+                Text(titles[step], style = MaterialTheme.typography.h5)
+                Text(descriptions[step], style = MaterialTheme.typography.body1)
+                Button(onClick = callbacks[step]) { Text(actions[step]) }
+                Spacer(Modifier.weight(1f))
+                Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween) {
+                    TextButton(onClick = onSkip) { Text("Skip setup") }
+                    Button(onClick = onNext) { Text(if (step == 4) "Finish" else "Continue") }
+                }
+            }
+        }
+    }
+}

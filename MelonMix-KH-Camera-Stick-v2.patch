@@ -0,0 +1,52 @@
+package me.magnum.melonds.ui.common.input
+
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import android.view.View
+import kotlin.math.min
+
+class KhCameraStickView(context: Context) : View(context) {
+    private val basePaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+        color = Color.argb(105, 20, 20, 20)
+        style = Paint.Style.FILL
+    }
+    private val ringPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+        color = Color.argb(145, 255, 255, 255)
+        style = Paint.Style.STROKE
+        strokeWidth = resources.displayMetrics.density * 2f
+    }
+    private val knobPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+        color = Color.argb(175, 255, 255, 255)
+        style = Paint.Style.FILL
+    }
+
+    private var stickX = 0f
+    private var stickY = 0f
+
+    fun setStickPosition(x: Float, y: Float) {
+        stickX = x.coerceIn(-1f, 1f)
+        stickY = y.coerceIn(-1f, 1f)
+        invalidate()
+    }
+
+    override fun onDraw(canvas: Canvas) {
+        super.onDraw(canvas)
+        val size = min(width, height).toFloat()
+        val centerX = width / 2f
+        val centerY = height / 2f
+        val baseRadius = size * 0.46f
+        val knobRadius = size * 0.18f
+        val travelRadius = baseRadius - knobRadius
+
+        canvas.drawCircle(centerX, centerY, baseRadius, basePaint)
+        canvas.drawCircle(centerX, centerY, baseRadius, ringPaint)
+        canvas.drawCircle(
+            centerX + stickX * travelRadius,
+            centerY + stickY * travelRadius,
+            knobRadius,
+            knobPaint,
+        )
+    }
+}

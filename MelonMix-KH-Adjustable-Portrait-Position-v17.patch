+            settingsRepository.getKhPortraitScreenPosition().collect {
+                uiLayoutProvider.setKhPortraitScreenPosition(it)
+            }
+        }
+    }
+
     private fun startObservingEmulatorEvents() {
         sessionCoroutineScope.launch {

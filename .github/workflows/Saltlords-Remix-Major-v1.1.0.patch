+package me.magnum.melonds.ui.emulator.input
+
+import android.view.MotionEvent
+import android.view.View
+import me.magnum.melonds.MelonEmulator
+import me.magnum.melonds.ui.common.input.KhCameraSwipeZoneView
+import kotlin.math.pow
+import kotlin.math.sqrt
+
+/**
+ * Turns relative drags over an invisible touchpad into short camera-axis pulses.
+ * Relative deltas make every new touch the centre, unlike a fixed virtual stick.
+ */
+class KhCameraSwipeInputHandler(
+    private val travelDp: Int,
+) : View.OnTouchListener {
+    private var pointerId = MotionEvent.INVALID_POINTER_ID
+    private var originX = 0f
+    private var originY = 0f
+
+    override fun onTouch(view: View, event: MotionEvent): Boolean {
+        val swipeView = view as? KhCameraSwipeZoneView ?: return false
+        when (event.actionMasked) {
+            MotionEvent.ACTION_DOWN -> {
+                pointerId = event.getPointerId(0)
+                originX = event.x
+                originY = event.y
+                swipeView.beginTouch(originX, originY, travelRadius(view))
+                MelonEmulator.setKhCameraAxes(0f, 0f)
+            }
+            MotionEvent.ACTION_MOVE -> {
+                val index = event.findPointerIndex(pointerId)
+                if (index >= 0) {
+                    val x = event.getX(index)
+                    val y = event.getY(index)
+                    updateCamera(swipeView, x, y)
+                }
+            }
+            MotionEvent.ACTION_POINTER_UP -> {
+                if (event.getPointerId(event.actionIndex) == pointerId) resetCamera(swipeView)
+            }
+            MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL -> {
+                resetCamera(swipeView)
+            }
+        }
+        return true
+    }
+
+    private fun updateCamera(view: KhCameraSwipeZoneView, touchX: Float, touchY: Float) {
+        val radius = travelRadius(view)
+        var x = (touchX - originX) / radius
+        var y = (touchY - originY) / radius
+        val magnitude = sqrt(x * x + y * y)
+
+        if (magnitude > 1f) {
+            x /= magnitude
+            y /= magnitude
+        } else if (magnitude < DEADZONE) {
+            x = 0f
+            y = 0f
+        } else {
+            val linearMagnitude = (magnitude - DEADZONE) / (1f - DEADZONE)
+            val curvedMagnitude = linearMagnitude.pow(RESPONSE_CURVE)
+            x = x / magnitude * curvedMagnitude
+            y = y / magnitude * curvedMagnitude
+        }
+
+        view.setStickPosition(x, y)
+        MelonEmulator.setKhCameraAxes(x * MAX_SPEED, y * MAX_SPEED)
+    }
+
+    private fun travelRadius(view: View): Float =
+        view.resources.displayMetrics.density * travelDp.coerceIn(32, 160)
+
+    private fun resetCamera(view: KhCameraSwipeZoneView) {
+        pointerId = MotionEvent.INVALID_POINTER_ID
+        view.endTouch()
+        MelonEmulator.setKhCameraAxes(0f, 0f)
+    }
+
+    private companion object {
+        const val DEADZONE = 0.08f
+        const val RESPONSE_CURVE = 1.6f
+        const val MAX_SPEED = 0.62f
+    }
+}

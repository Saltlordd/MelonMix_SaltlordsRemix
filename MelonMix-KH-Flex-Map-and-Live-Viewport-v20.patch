@@ -174,6 +174,7 @@ class EmulatorActivity : AppCompatActivity() {
     // e.g. dual-screen layouts with single-screen mode off)
     private val khTopScreenRect = androidx.compose.runtime.mutableStateOf<me.magnum.melonds.domain.model.Rect?>(null)
     private val khFlexMode = androidx.compose.runtime.mutableStateOf(false)
+    private var khFoldGeometrySignature: String? = null
 
     private lateinit var handler: Handler
     private val displayListener = object : DisplayManager.DisplayListener {
@@ -392,6 +393,9 @@ class EmulatorActivity : AppCompatActivity() {
                 KhCutscenePlayerUi(
                     state = khCutsceneState.value,
                     paused = khPauseMenuState.value != null || khEmulatorPaused.value,
+                    // A separating horizontal hinge is the authoritative Flex signal. Some
+                    // devices report FLAT while still separating, so gating this on HALF_OPENED
+                    // allowed HD video to escape back to the full window.
                     viewportBounds = khTopScreenRect.value.takeIf { khFlexMode.value },
                     onEnded = { MelonEmulator.onKhCutsceneEnded() },
                     onFailed = { MelonEmulator.onKhCutsceneFailed(it) },
@@ -657,7 +661,7 @@ class EmulatorActivity : AppCompatActivity() {
                 WindowInfoTracker.getOrCreate(this@EmulatorActivity).windowLayoutInfo(this@EmulatorActivity).collect {
                     khFlexMode.value = it.displayFeatures.any { feature ->
                         feature is FoldingFeature &&
-                            feature.state == FoldingFeature.State.HALF_OPENED &&
+                            feature.isSeparating &&
                             feature.orientation == FoldingFeature.Orientation.HORIZONTAL
                     }
                     val folds = it.displayFeatures.mapNotNull {
@@ -672,6 +676,13 @@ class EmulatorActivity : AppCompatActivity() {
                         }
                     }
                     viewModel.setScreenFolds(folds)
+                    val foldGeometrySignature = folds.joinToString("|") { fold ->
+                        "${fold.orientation}:${fold.type}:${fold.foldBounds}"
+                    }
+                    if (foldGeometrySignature != khFoldGeometrySignature) {
+                        khFoldGeometrySignature = foldGeometrySignature
+                        rebuildKhCompositorViewport()
+                    }
                 }
             }
         }
@@ -919,6 +930,31 @@ class EmulatorActivity : AppCompatActivity() {
         }
     }
 
+    /**
+     * [KHMM v20] A fold posture can change without changing the Android window's outer width or
+     * height. In that case the ordinary OnLayoutChangeListener never runs, leaving both the
+     * renderer crop and the KH plugin's internal widescreen value at the previous posture.
+     * Rebuild the runtime layout, then sample it across consecutive UI frames: the first pass
+     * requests/recreates the hinge-derived viewport and the following passes reinject its final
+     * aspect into the native compositor after Android has committed the new child bounds.
+     */
+    private fun rebuildKhCompositorViewport() {
+        binding.viewLayoutControls.requestLayout()
+        binding.surfaceMain.requestLayout()
+
+        fun reinject(framesRemaining: Int) {
+            binding.viewLayoutControls.postOnAnimation {
+                updateRendererScreenAreas()
+                binding.surfaceMain.invalidate()
+                if (framesRemaining > 1) reinject(framesRemaining - 1)
+            }
+        }
+        reinject(3)
+        // UILayoutProvider deliberately debounces its multi-flow geometry update by 50 ms.
+        // This final pass lands after that transaction even on a 120 Hz Fold display.
+        binding.viewLayoutControls.postDelayed({ updateRendererScreenAreas() }, 90L)
+    }
+
     private fun setupInputHandling(controllerConfiguration: ControllerConfiguration) {
         nativeInputListener = InputProcessor(controllerConfiguration, melonTouchHandler, frontendInputHandler)
     }

diff --git a/app/src/main/java/me/magnum/melonds/impl/layout/DefaultLayoutProvider.kt b/app/src/main/java/me/magnum/melonds/impl/layout/DefaultLayoutProvider.kt
index 58f6712..38d3334 100644
--- a/app/src/main/java/me/magnum/melonds/impl/layout/DefaultLayoutProvider.kt
+++ b/app/src/main/java/me/magnum/melonds/impl/layout/DefaultLayoutProvider.kt
@@ -27,6 +27,62 @@ class DefaultLayoutProvider(
     private val screenUnitsConverter: ScreenUnitsConverter,
 ) {
 
+    /** KH-first controls used by the built-in layout in single-screen mode. */
+    fun buildKhDefaultLayout(variant: UILayoutVariant): UILayout {
+        val base = buildDefaultLayout(variant)
+        val width = variant.uiSize.x
+        val height = variant.uiSize.y
+        val left = variant.uiInsets.left
+        val top = variant.uiInsets.top
+        val safeWidth = width - left - variant.uiInsets.right
+        val safeHeight = height - top - variant.uiInsets.bottom
+        fun rect(x: Float, y: Float, w: Float, h: Float) = Rect(
+            left + (safeWidth * x).roundToInt(), top + (safeHeight * y).roundToInt(),
+            (safeWidth * w).roundToInt(), (safeHeight * h).roundToInt(),
+        )
+
+        val portrait = height > width
+        val controls = if (!portrait) {
+            listOf(
+                PositionedLayoutComponent(rect(0.00f, 0.42f, 0.42f, 0.48f), LayoutComponent.MOVEMENT_STICK, 0.16f),
+                PositionedLayoutComponent(rect(0.50f, 0.42f, 0.50f, 0.48f), LayoutComponent.KH_CAMERA_SWIPE_ZONE, 0.16f),
+                PositionedLayoutComponent(rect(0.04f, 0.42f, 0.16f, 0.16f), LayoutComponent.KH_COMMAND_PAD, 0.55f),
+                PositionedLayoutComponent(rect(0.08f, 0.59f, 0.075f, 0.085f), LayoutComponent.BUTTON_L_SHORTCUT_TOGGLE, 0.75f),
+                PositionedLayoutComponent(rect(0.81f, 0.40f, 0.075f, 0.085f), LayoutComponent.BUTTON_KH_GUARD, 0.75f),
+                PositionedLayoutComponent(rect(0.90f, 0.40f, 0.075f, 0.085f), LayoutComponent.BUTTON_KH_X, 0.75f),
+                PositionedLayoutComponent(rect(0.72f, 0.52f, 0.075f, 0.085f), LayoutComponent.BUTTON_KH_JUMP, 0.75f),
+                PositionedLayoutComponent(rect(0.84f, 0.50f, 0.11f, 0.13f), LayoutComponent.BUTTON_KH_ATTACK, 0.75f),
+                PositionedLayoutComponent(rect(0.91f, 0.65f, 0.075f, 0.085f), LayoutComponent.BUTTON_KH_LOCK_ON, 0.75f),
+                PositionedLayoutComponent(rect(0.935f, 0.025f, 0.055f, 0.065f), LayoutComponent.BUTTON_KH_TOGGLE_CONTROLS, 0.85f),
+                PositionedLayoutComponent(rect(0.015f, 0.92f, 0.055f, 0.065f), LayoutComponent.BUTTON_FAST_FORWARD_TOGGLE, 0.60f),
+                PositionedLayoutComponent(rect(0.74f, 0.92f, 0.055f, 0.065f), LayoutComponent.BUTTON_L, 0.60f),
+                PositionedLayoutComponent(rect(0.81f, 0.92f, 0.055f, 0.065f), LayoutComponent.BUTTON_R, 0.60f),
+                PositionedLayoutComponent(rect(0.89f, 0.92f, 0.045f, 0.055f), LayoutComponent.BUTTON_SELECT, 0.60f),
+                PositionedLayoutComponent(rect(0.95f, 0.92f, 0.045f, 0.055f), LayoutComponent.BUTTON_START, 0.60f),
+            )
+        } else {
+            listOf(
+                PositionedLayoutComponent(rect(0.00f, 0.48f, 0.50f, 0.40f), LayoutComponent.MOVEMENT_STICK, 0.16f),
+                PositionedLayoutComponent(rect(0.50f, 0.48f, 0.50f, 0.40f), LayoutComponent.KH_CAMERA_SWIPE_ZONE, 0.16f),
+                PositionedLayoutComponent(rect(0.04f, 0.58f, 0.23f, 0.13f), LayoutComponent.KH_COMMAND_PAD, 0.55f),
+                PositionedLayoutComponent(rect(0.08f, 0.73f, 0.12f, 0.065f), LayoutComponent.BUTTON_L_SHORTCUT_TOGGLE, 0.75f),
+                PositionedLayoutComponent(rect(0.72f, 0.57f, 0.12f, 0.065f), LayoutComponent.BUTTON_KH_GUARD, 0.75f),
+                PositionedLayoutComponent(rect(0.86f, 0.57f, 0.12f, 0.065f), LayoutComponent.BUTTON_KH_X, 0.75f),
+                PositionedLayoutComponent(rect(0.64f, 0.68f, 0.12f, 0.065f), LayoutComponent.BUTTON_KH_JUMP, 0.75f),
+                PositionedLayoutComponent(rect(0.78f, 0.66f, 0.18f, 0.10f), LayoutComponent.BUTTON_KH_ATTACK, 0.75f),
+                PositionedLayoutComponent(rect(0.86f, 0.79f, 0.12f, 0.065f), LayoutComponent.BUTTON_KH_LOCK_ON, 0.75f),
+                PositionedLayoutComponent(rect(0.90f, 0.02f, 0.085f, 0.05f), LayoutComponent.BUTTON_KH_TOGGLE_CONTROLS, 0.85f),
+                PositionedLayoutComponent(rect(0.02f, 0.93f, 0.085f, 0.05f), LayoutComponent.BUTTON_FAST_FORWARD_TOGGLE, 0.60f),
+                PositionedLayoutComponent(rect(0.63f, 0.93f, 0.085f, 0.05f), LayoutComponent.BUTTON_L, 0.60f),
+                PositionedLayoutComponent(rect(0.73f, 0.93f, 0.085f, 0.05f), LayoutComponent.BUTTON_R, 0.60f),
+                PositionedLayoutComponent(rect(0.83f, 0.93f, 0.075f, 0.05f), LayoutComponent.BUTTON_SELECT, 0.60f),
+                PositionedLayoutComponent(rect(0.92f, 0.93f, 0.075f, 0.05f), LayoutComponent.BUTTON_START, 0.60f),
+            )
+        }
+        val screens = base.mainScreenLayout.components.orEmpty().filter { it.isScreen() }
+        return base.copy(mainScreenLayout = base.mainScreenLayout.copy(components = screens + controls))
+    }
+
     fun buildDefaultLayout(variant: UILayoutVariant): UILayout {
         val width = variant.uiSize.x
         val height = variant.uiSize.y
@@ -381,4 +437,4 @@ class DefaultLayoutProvider(
             Insets(displayCutout.safeInsetLeft, displayCutout.safeInsetTop, displayCutout.safeInsetRight, displayCutout.safeInsetBottom)
         }
     }
-}
\ No newline at end of file

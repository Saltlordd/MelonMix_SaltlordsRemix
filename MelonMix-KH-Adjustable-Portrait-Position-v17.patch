@@ -64,26 +74,35 @@ class UILayoutProvider(private val defaultLayoutProvider: DefaultLayoutProvider)
         khTopScreenOnly.value = enabled
     }
 
+    fun setKhPortraitScreenPosition(position: Int) {
+        khPortraitScreenPosition.value = position.coerceIn(0, 50)
+    }
+
     // [KHMM] Replace the screen components of the layout that would otherwise be shown with a
     // single TOP_SCREEN covering the whole UI (landscape: stretched full-screen; portrait: a
-    // full-width 16:9 box, vertically centered). Buttons and other components are kept as the
-    // user/default layout placed them. The on-screen rect's real aspect ratio is pushed to the
-    // plugin separately, so stretching does not distort the composite.
-    private fun buildKhTopScreenOnlyLayout(baseLayout: UILayout, variant: UILayoutVariant): UILayout {
+    // full-width 4:3 box positioned within the safe vertical gap). Buttons and other components
+    // are kept as the user/default layout placed them. The on-screen rect's real aspect ratio is
+    // pushed to the plugin separately, so stretching does not distort the composite.
+    private fun buildKhTopScreenOnlyLayout(
+        baseLayout: UILayout,
+        variant: UILayoutVariant,
+        portraitScreenPosition: Int,
+    ): UILayout {
         val uiWidth = variant.uiSize.x
         val uiHeight = variant.uiSize.y
         val screenRect = if (uiHeight > uiWidth) {
             // A landscape 4:3 viewport uses substantially more of a tall cover display
             // than 16:9 while retaining the DS-like presentation requested by KHDS. Place
-            // it 40% of the way through the safe vertical gap instead of dead-centre: this
-            // leaves a little more clear control space below on both cover and unfolded
-            // portrait displays, without ever crossing a cutout/system-bar safe inset.
+            // it 20% of the way through the safe vertical gap instead of dead-centre: this
+            // creates a handheld-like upper-screen composition and leaves more clear control
+            // space below on both cover and unfolded portrait displays, without ever crossing
+            // a cutout/system-bar safe inset.
             val boxHeight = (uiWidth * 3f / 4f).toInt()
             val safeTop = variant.uiInsets.top
             val safeBottom = variant.uiInsets.bottom
             val safeHeight = (uiHeight - safeTop - safeBottom).coerceAtLeast(0)
             val spareHeight = (safeHeight - boxHeight).coerceAtLeast(0)
-            val biasedTop = safeTop + (spareHeight * 0.40f).toInt()
+            val biasedTop = safeTop + (spareHeight * portraitScreenPosition / 100f).toInt()
             Rect(0, biasedTop, uiWidth, boxHeight)
         } else {
             // [KH touch] The unfolded Fold display is squarer than the DS UI's 4:3

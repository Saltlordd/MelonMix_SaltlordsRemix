new file mode 100644
index 00000000..ce57e562
--- /dev/null
+++ b/app/src/main/java/me/magnum/melonds/ui/shortcutsetup/KhGameShortcut.kt
@@ -0,0 +1,82 @@
+package me.magnum.melonds.ui.shortcutsetup
+
+import android.content.Context
+import android.content.Intent
+import android.graphics.Bitmap
+import android.graphics.BitmapFactory
+import android.graphics.Canvas
+import android.graphics.Paint
+import android.graphics.Rect
+import android.net.Uri
+import android.os.Build
+import androidx.core.content.pm.ShortcutInfoCompat
+import androidx.core.content.pm.ShortcutManagerCompat
+import androidx.core.graphics.drawable.IconCompat
+import me.magnum.melonds.R
+import me.magnum.melonds.domain.model.rom.config.LaunchDisplayProfile
+import java.util.UUID
+
+/** A shortcut carries identity and optional session choices; it never carries a saved ROM config. */
+object KhGameShortcut {
+    const val KEY_GAME_CODE = "remix_shortcut_game_code"
+    const val KEY_DISPLAY_PROFILE = "remix_shortcut_display_profile"
+    const val KEY_LAYOUT_SELECTED = "remix_shortcut_layout_selected"
+    const val KEY_LAYOUT_ID = "remix_shortcut_layout_id"
+    const val KEY_DIRECT_LAUNCH = "remix_shortcut_direct_launch"
+
+    fun labelForCode(code: String?): String? = when (code) {
+        "YKGP", "YKGJ", "YKGE" -> "358/2 Days"
+        "BK9P", "BK9J", "BK9E" -> "Re:Coded"
+        else -> null
+    }
+
+    fun requestPin(
+        context: Context,
+        gameCode: String,
+        profile: LaunchDisplayProfile? = null,
+        hasLayoutChoice: Boolean = false,
+        layoutId: UUID? = null,
+    ): Boolean {
+        val label = labelForCode(gameCode) ?: return false
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.O ||
+            !ShortcutManagerCompat.isRequestPinShortcutSupported(context)) return false
+
+        // Distinct IDs permit multiple shortcuts for one game with different session choices.
+        val id = UUID.randomUUID().toString()
+        val intent = Intent(context, GameShortcutActivity::class.java).apply {
+            action = Intent.ACTION_VIEW
+            data = Uri.parse("saltlords-remix://game-shortcut/$id")
+            putExtra(KEY_GAME_CODE, gameCode)
+            profile?.let { putExtra(KEY_DISPLAY_PROFILE, it.name) }
+            if (hasLayoutChoice) {
+                putExtra(KEY_LAYOUT_SELECTED, true)
+                layoutId?.let { putExtra(KEY_LAYOUT_ID, it.toString()) }
+            }
+        }
+        val shortcut = ShortcutInfoCompat.Builder(context, id)
+            .setShortLabel(label)
+            .setIcon(IconCompat.createWithAdaptiveBitmap(iconBitmap(context, gameCode)))
+            .setIntent(intent)
+            .build()
+        return ShortcutManagerCompat.requestPinShortcut(context, shortcut, null)
+    }
+
+    private fun iconBitmap(context: Context, gameCode: String): Bitmap {
+        val foreground = if (labelForCode(gameCode) == "358/2 Days")
+            R.drawable.shortcut_days_foreground else R.drawable.shortcut_recoded_foreground
+        val tile = BitmapFactory.decodeResource(context.resources, R.drawable.shortcut_background)
+        val artwork = BitmapFactory.decodeResource(context.resources, foreground)
+        val bitmap = Bitmap.createBitmap(256, 256, Bitmap.Config.ARGB_8888)
+        val canvas = Canvas(bitmap)
+        val paint = Paint(Paint.ANTI_ALIAS_FLAG or Paint.FILTER_BITMAP_FLAG)
+        canvas.drawBitmap(tile, null, Rect(0, 0, 256, 256), paint)
+        // Match the existing main icon's ~two-thirds-width adaptive safe-area motif.
+        val width = 174
+        val height = (width * artwork.height.toFloat() / artwork.width).toInt()
+        canvas.drawBitmap(artwork, null, Rect((256 - width) / 2, (256 - height) / 2,
+            (256 + width) / 2, (256 + height) / 2), paint)
+        tile.recycle()
+        artwork.recycle()
+        return bitmap
+    }
+}

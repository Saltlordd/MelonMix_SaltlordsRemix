diff --git a/app/src/main/java/me/magnum/melonds/ui/common/input/KhCameraStickView.kt b/app/src/main/java/me/magnum/melonds/ui/common/input/KhCameraStickView.kt
index 5ec1f6b..bae3f14 100644
--- a/app/src/main/java/me/magnum/melonds/ui/common/input/KhCameraStickView.kt
+++ b/app/src/main/java/me/magnum/melonds/ui/common/input/KhCameraStickView.kt
@@ -26,17 +26,20 @@ class KhCameraStickView(context: Context) : View(context) {
     private var stickY = 0f
     private var originX = 0f
     private var originY = 0f
+    private var summonedRadius: Float? = null
     private var active = false
 
-    fun beginTouch(x: Float, y: Float) {
+    fun beginTouch(x: Float, y: Float, radius: Float? = null) {
         originX = x
         originY = y
+        summonedRadius = radius
         active = true
         setStickPosition(0f, 0f)
     }
 
     fun endTouch() {
         active = false
+        summonedRadius = null
         setStickPosition(0f, 0f)
     }
 
@@ -55,8 +58,8 @@ class KhCameraStickView(context: Context) : View(context) {
         val size = min(width, height).toFloat()
         val centerX = originX
         val centerY = originY
-        val baseRadius = size * 0.46f
-        val knobRadius = size * 0.18f
+        val baseRadius = summonedRadius ?: (size * 0.46f)
+        val knobRadius = if (summonedRadius != null) baseRadius * 0.32f else size * 0.18f
         val travelRadius = baseRadius - knobRadius
 
         canvas.drawCircle(centerX, centerY, baseRadius, basePaint)

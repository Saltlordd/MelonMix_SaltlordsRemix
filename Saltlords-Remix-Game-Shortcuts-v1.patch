@@ -0,0 +1,97 @@
+package me.magnum.melonds.ui.shortcutsetup
+
+import android.content.Intent
+import android.os.Bundle
+import android.widget.Toast
+import androidx.appcompat.app.AppCompatActivity
+import androidx.lifecycle.lifecycleScope
+import dagger.hilt.android.AndroidEntryPoint
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+import kotlinx.coroutines.withTimeoutOrNull
+import me.magnum.melonds.common.romprocessors.RomFileProcessorFactory
+import me.magnum.melonds.domain.model.ConsoleType
+import me.magnum.melonds.domain.model.RomScanningStatus
+import me.magnum.melonds.domain.model.rom.Rom
+import me.magnum.melonds.domain.model.rom.config.LaunchDisplayProfile
+import me.magnum.melonds.domain.repositories.RomsRepository
+import me.magnum.melonds.ui.common.rom.EmulatorLaunchValidatorDelegate
+import me.magnum.melonds.ui.emulator.EmulatorActivity
+import me.magnum.melonds.ui.romlist.RomListActivity
+import java.util.UUID
+import javax.inject.Inject
+
+/** Resolves the current library entry before entering the regular validated ROM launch path. */
+@AndroidEntryPoint
+class GameShortcutActivity : AppCompatActivity() {
+    @Inject lateinit var romsRepository: RomsRepository
+    @Inject lateinit var romFileProcessorFactory: RomFileProcessorFactory
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        val gameCode = intent.getStringExtra(KhGameShortcut.KEY_GAME_CODE)
+        if (KhGameShortcut.labelForCode(gameCode) == null) {
+            showMissingGame()
+            return
+        }
+
+        val validator = EmulatorLaunchValidatorDelegate(this, object : EmulatorLaunchValidatorDelegate.Callback {
+            override fun onRomValidated(rom: Rom) {
+                startActivity(EmulatorActivity.getRomEmulatorActivityIntent(this@GameShortcutActivity, rom).apply {
+                    putExtra(KhGameShortcut.KEY_DIRECT_LAUNCH, true)
+                })
+                finish()
+            }
+            override fun onFirmwareValidated(consoleType: ConsoleType) = Unit
+            override fun onValidationAborted() { finish() }
+        })
+
+        lifecycleScope.launch {
+            val rom = withContext(Dispatchers.IO) {
+                // getRoms() loads the existing cache and scans configured directories.
+                // Wait for that scan so a cold shortcut does not mistake an empty cache
+                // for a missing game.
+                val initial = withTimeoutOrNull(30_000) { romsRepository.getRoms().first() }
+                    ?: return@withContext null
+                if (romsRepository.getRomScanningStatus().value == RomScanningStatus.SCANNING) {
+                    withTimeoutOrNull(30_000) {
+                        romsRepository.getRomScanningStatus().first { it == RomScanningStatus.NOT_SCANNING }
+                    } ?: return@withContext null
+                }
+                val roms = withTimeoutOrNull(30_000) { romsRepository.getRoms().first() } ?: initial
+                roms.firstOrNull { candidate ->
+                    romFileProcessorFactory.getFileRomProcessorForDocument(candidate.uri)
+                        ?.getRomInfo(candidate)?.gameCode == gameCode
+                }?.takeIf { candidate ->
+                    runCatching { contentResolver.openFileDescriptor(candidate.uri, "r")?.use { true } == true }
+                        .getOrDefault(false)
+                }
+            }
+            if (rom == null) {
+                showMissingGame()
+                return@launch
+            }
+
+            // The current repository config is copied for this session only. Never call
+            // updateRomConfig; changing display/layout here cannot persist or leak.
+            val profile = intent.getStringExtra(KhGameShortcut.KEY_DISPLAY_PROFILE)
+                ?.let { runCatching { LaunchDisplayProfile.valueOf(it) }.getOrNull() }
+            val chooseLayout = intent.getBooleanExtra(KhGameShortcut.KEY_LAYOUT_SELECTED, false)
+            val layoutId = intent.getStringExtra(KhGameShortcut.KEY_LAYOUT_ID)
+                ?.let { runCatching { UUID.fromString(it) }.getOrNull() }
+            val sessionRom = rom.copy(config = rom.config.copy(
+                launchDisplayProfile = profile ?: rom.config.launchDisplayProfile,
+                layoutId = if (chooseLayout) layoutId else rom.config.layoutId,
+            ))
+            validator.validateRom(sessionRom)
+        }
+    }
+
+    private fun showMissingGame() {
+        Toast.makeText(this, "The game's ROM could not be found or accessed. Check your game folders in Saltlord’s Remix.", Toast.LENGTH_LONG).show()
+        startActivity(Intent(this, RomListActivity::class.java))
+        finish()
+    }
+}

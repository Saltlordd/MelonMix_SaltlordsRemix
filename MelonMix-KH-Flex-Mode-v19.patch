From a21f1281b4b4d088216e70d4c792bd74b7829f6a Mon Sep 17 00:00:00 2001
From: Codex <codex@example.invalid>
Date: Mon, 14 Sep 2026 08:59:28 +0100
Subject: [PATCH] Add full-panel KH flex mode and quieter portrait background

---
 .../melonds/impl/layout/UILayoutProvider.kt   |  26 +++++++++++++++++-
 .../melonds/ui/emulator/EmulatorActivity.kt   |  13 ++++++++-
 .../melonds/ui/emulator/EmulatorViewModel.kt  |   4 +++
 .../ui/emulator/ui/KhCutscenePlayerUi.kt      |  17 ++++++++++--
 .../drawable-nodpi/kh_bg_folded_portrait.jpg  | Bin 134637 -> 124856 bytes
 5 files changed, 55 insertions(+), 5 deletions(-)

diff --git a/app/src/main/java/me/magnum/melonds/impl/layout/UILayoutProvider.kt b/app/src/main/java/me/magnum/melonds/impl/layout/UILayoutProvider.kt
index 393760f..23a47d8 100644
--- a/app/src/main/java/me/magnum/melonds/impl/layout/UILayoutProvider.kt
+++ b/app/src/main/java/me/magnum/melonds/impl/layout/UILayoutProvider.kt
@@ -90,7 +90,31 @@ class UILayoutProvider(private val defaultLayoutProvider: DefaultLayoutProvider)
     ): UILayout {
         val uiWidth = variant.uiSize.x
         val uiHeight = variant.uiSize.y
-        val screenRect = if (uiHeight > uiWidth) {
+        // WindowManager reports a horizontal HALF_OPENED fold as separating. The existing
+        // ScreenFold bridge represents that combination as LANDSCAPE + SEAMLESS. Use the
+        // actual hinge coordinate so tabletop mode works across Fold and Pixel Fold sizes.
+        val flexFold = variant.folds.firstOrNull {
+            it.orientation == Orientation.LANDSCAPE &&
+                it.type == ScreenFold.FoldType.SEAMLESS &&
+                it.foldBounds.y > variant.uiInsets.top &&
+                it.foldBounds.y < uiHeight - variant.uiInsets.bottom
+        }
+        val screenRect = if (flexFold != null) {
+            val safeLeft = variant.uiInsets.left
+            val safeTop = variant.uiInsets.top
+            val safeWidth = (uiWidth - safeLeft - variant.uiInsets.right).coerceAtLeast(0)
+            val topPanelHeight = (flexFold.foldBounds.y - safeTop).coerceAtLeast(0)
+            // Flex mode is its own DS-like presentation: give the KH compositor the whole
+            // physical upper panel rather than fitting a conventional 16:9 box inside it.
+            // The compositor receives this real aspect ratio, so gameplay expands ultrawide
+            // without stretching. Fixed-aspect HD videos letterbox within the same rectangle.
+            Rect(
+                safeLeft,
+                safeTop,
+                safeWidth,
+                topPanelHeight,
+            )
+        } else if (uiHeight > uiWidth) {
             // A landscape 4:3 viewport uses substantially more of a tall cover display
             // than 16:9 while retaining the DS-like presentation requested by KHDS. Place
             // it 20% of the way through the safe vertical gap instead of dead-centre: this
diff --git a/app/src/main/java/me/magnum/melonds/ui/emulator/EmulatorActivity.kt b/app/src/main/java/me/magnum/melonds/ui/emulator/EmulatorActivity.kt
index cc3bdc3..ef0f5f3 100644
--- a/app/src/main/java/me/magnum/melonds/ui/emulator/EmulatorActivity.kt
+++ b/app/src/main/java/me/magnum/melonds/ui/emulator/EmulatorActivity.kt
@@ -173,6 +173,7 @@ class EmulatorActivity : AppCompatActivity() {
     // centers on the game display instead of the window (they differ on non-forced layouts,
     // e.g. dual-screen layouts with single-screen mode off)
     private val khTopScreenRect = androidx.compose.runtime.mutableStateOf<me.magnum.melonds.domain.model.Rect?>(null)
+    private val khFlexMode = androidx.compose.runtime.mutableStateOf(false)
 
     private lateinit var handler: Handler
     private val displayListener = object : DisplayManager.DisplayListener {
@@ -391,6 +392,7 @@ class EmulatorActivity : AppCompatActivity() {
                 KhCutscenePlayerUi(
                     state = khCutsceneState.value,
                     paused = khPauseMenuState.value != null || khEmulatorPaused.value,
+                    viewportBounds = khTopScreenRect.value.takeIf { khFlexMode.value },
                     onEnded = { MelonEmulator.onKhCutsceneEnded() },
                     onFailed = { MelonEmulator.onKhCutsceneFailed(it) },
                 )
@@ -399,7 +401,11 @@ class EmulatorActivity : AppCompatActivity() {
                 // full-window video); otherwise anchored to the top-screen viewport.
                 KhPauseMenuUi(
                     state = khPauseMenuState.value,
-                    menuBounds = if (khCutsceneState.value != null) null else khTopScreenRect.value,
+                    menuBounds = if (khFlexMode.value || khCutsceneState.value == null) {
+                        khTopScreenRect.value
+                    } else {
+                        null
+                    },
                 )
 
                 RewindWindowUi(
@@ -649,6 +655,11 @@ class EmulatorActivity : AppCompatActivity() {
         lifecycleScope.launch {
             lifecycle.repeatOnLifecycle(Lifecycle.State.STARTED) {
                 WindowInfoTracker.getOrCreate(this@EmulatorActivity).windowLayoutInfo(this@EmulatorActivity).collect {
+                    khFlexMode.value = it.displayFeatures.any { feature ->
+                        feature is FoldingFeature &&
+                            feature.state == FoldingFeature.State.HALF_OPENED &&
+                            feature.orientation == FoldingFeature.Orientation.HORIZONTAL
+                    }
                     val folds = it.displayFeatures.mapNotNull {
                         if (it is FoldingFeature) {
                             ScreenFold(
diff --git a/app/src/main/java/me/magnum/melonds/ui/emulator/EmulatorViewModel.kt b/app/src/main/java/me/magnum/melonds/ui/emulator/EmulatorViewModel.kt
index 337a984..2e98b7b 100644
--- a/app/src/main/java/me/magnum/melonds/ui/emulator/EmulatorViewModel.kt
+++ b/app/src/main/java/me/magnum/melonds/ui/emulator/EmulatorViewModel.kt
@@ -925,7 +925,11 @@ class EmulatorViewModel @Inject constructor(
         val portrait = height > width
         val shortToLongRatio = minOf(width, height) / maxOf(width, height).toFloat()
         val unfolded = variant.folds.isNotEmpty() || shortToLongRatio >= 0.70f
+        val flexMode = variant.folds.any {
+            it.orientation == Orientation.LANDSCAPE && it.type == ScreenFold.FoldType.SEAMLESS
+        }
         val drawableId = when {
+            flexMode -> R.drawable.kh_bg_unfolded_landscape
             unfolded && portrait -> R.drawable.kh_bg_unfolded_portrait
             unfolded -> R.drawable.kh_bg_unfolded_landscape
             portrait -> R.drawable.kh_bg_folded_portrait
diff --git a/app/src/main/java/me/magnum/melonds/ui/emulator/ui/KhCutscenePlayerUi.kt b/app/src/main/java/me/magnum/melonds/ui/emulator/ui/KhCutscenePlayerUi.kt
index 8faf141..240663b 100644
--- a/app/src/main/java/me/magnum/melonds/ui/emulator/ui/KhCutscenePlayerUi.kt
+++ b/app/src/main/java/me/magnum/melonds/ui/emulator/ui/KhCutscenePlayerUi.kt
@@ -7,7 +7,9 @@ import androidx.compose.foundation.layout.Box
 import androidx.compose.foundation.layout.BoxWithConstraints
 import androidx.compose.foundation.layout.aspectRatio
 import androidx.compose.foundation.layout.fillMaxSize
+import androidx.compose.foundation.layout.offset
 import androidx.compose.foundation.layout.padding
+import androidx.compose.foundation.layout.size
 import androidx.compose.material.Text
 import androidx.compose.runtime.Composable
 import androidx.compose.runtime.DisposableEffect
@@ -43,6 +45,7 @@ import androidx.media3.exoplayer.ExoPlayer
 import kotlinx.coroutines.delay
 import me.magnum.melonds.MelonEmulator
 import me.magnum.melonds.R
+import me.magnum.melonds.domain.model.Rect
 import me.magnum.melonds.domain.model.emulator.KhCutsceneState
 import java.io.File
 
@@ -66,6 +69,7 @@ import java.io.File
 fun KhCutscenePlayerUi(
     state: KhCutsceneState?,
     paused: Boolean,
+    viewportBounds: Rect? = null,
     onEnded: () -> Unit,
     onFailed: (String) -> Unit,
 ) {
@@ -169,10 +173,17 @@ fun KhCutscenePlayerUi(
         }
     }
 
+    val density = LocalDensity.current
+    val viewportModifier = viewportBounds?.let { bounds ->
+        with(density) {
+            Modifier
+                .offset(x = bounds.x.toDp(), y = bounds.y.toDp())
+                .size(width = bounds.width.toDp(), height = bounds.height.toDp())
+        }
+    } ?: Modifier.fillMaxSize()
+
     Box(
-        modifier = Modifier
-            .fillMaxSize()
-            .background(Color.Black),
+        modifier = viewportModifier.background(Color.Black),
         contentAlignment = Alignment.Center,
     ) {
         BoxWithConstraints(modifier = Modifier.aspectRatio(16f / 9f)) {

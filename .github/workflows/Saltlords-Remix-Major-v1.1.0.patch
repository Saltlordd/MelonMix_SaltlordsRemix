+    private fun getBackgroundUvs(mode: BackgroundMode, bgWidth: Int, bgHeight: Int): FloatArray {
+        var left = 0f
+        var right = 1f
+        var top = 0f
+        var bottom = 1f
+        if (mode == BackgroundMode.FILL_CENTER) {
+            val backgroundAspect = bgWidth / bgHeight.toFloat()
+            val screenAspect = viewWidth / viewHeight.toFloat()
+            if (screenAspect > backgroundAspect) {
+                val visibleHeight = backgroundAspect / screenAspect
+                top = (1f - visibleHeight) / 2f
+                bottom = 1f - top
+            } else {
+                val visibleWidth = screenAspect / backgroundAspect
+                left = (1f - visibleWidth) / 2f
+                right = 1f - left
+            }
+        }
+        return floatArrayOf(
+            left, bottom,
+            left, top,
+            right, top,
+            left, bottom,
+            right, top,
+            right, bottom,
+        )
+    }
+}

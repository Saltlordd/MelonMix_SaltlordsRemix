new file mode 100644
index 00000000..29e4435a
--- /dev/null
+++ b/app/src/main/res/drawable/ic_launcher_layers.xml
@@ -0,0 +1,7 @@
+<?xml version="1.0" encoding="utf-8"?>
+<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
+    <!-- Keep the supplied transparent tile together with the unchanged main foreground.
+         A transparent tile used as an adaptive background can flatten to black. -->
+    <item android:drawable="@mipmap/ic_launcher_background" />
+    <item android:drawable="@mipmap/ic_launcher_foreground" />
+</layer-list>
diff --git a/app/src/main/res/mipmap-anydpi-v26/ic_launcher.xml b/app/src/main/res/mipmap-anydpi-v26/ic_launcher.xml

+    private fun getBackgroundUvs(backgroundMode: BackgroundMode, backgroundWidth: Int, backgroundHeight: Int): FloatArray {
+        var left = 0f
+        var right = 1f
+        var top = 0f
+        var bottom = 1f
+        if (backgroundMode == BackgroundMode.FILL_CENTER) {
+            val backgroundAspect = backgroundWidth / backgroundHeight.toFloat()
+            val screenAspect = width / height
+            if (screenAspect > backgroundAspect) {
+                val visibleHeight = backgroundAspect / screenAspect
+                top = (1f - visibleHeight) / 2f
+                bottom = 1f - top
+            } else {
+                val visibleWidth = screenAspect / backgroundAspect
+                left = (1f - visibleWidth) / 2f
+                right = 1f - left
+            }
+        }
+        return floatArrayOf(
+            left, bottom,
+            left, top,
+            right, top,
+            left, bottom,
+            right, top,
+            right, bottom,
+        )
+    }
+}

+    private fun withFixedCinematicRotateControl(layout: UILayout): UILayout {
+        val components = layout.mainScreenLayout.components.orEmpty()
+            .filterNot { it.component == LayoutComponent.BUTTON_KH_CINEMATIC_ROTATE }
+        val canvasWidth = components.maxOfOrNull { it.rect.right }?.coerceAtLeast(width) ?: width
+        val canvasHeight = components.maxOfOrNull { it.rect.bottom }?.coerceAtLeast(height) ?: height
+        if (canvasWidth <= 0 || canvasHeight <= 0) return layout
+
+        val portrait = canvasHeight > canvasWidth
+        val rotateRect = Rect(
+            x = (canvasWidth * if (portrait) 0.88f else 0.90f).toInt(),
+            y = (canvasHeight * if (portrait) 0.05f else 0.08f).toInt(),
+            width = (canvasWidth * if (portrait) 0.09f else 0.07f).toInt(),
+            height = (canvasHeight * if (portrait) 0.06f else 0.10f).toInt(),
+        )
+        return layout.copy(
+            mainScreenLayout = layout.mainScreenLayout.copy(
+                components = components + PositionedLayoutComponent(
+                    rect = rotateRect,
+                    component = LayoutComponent.BUTTON_KH_CINEMATIC_ROTATE,
+                    alpha = 0.50f,
+                )
+            )
+        )
+    }

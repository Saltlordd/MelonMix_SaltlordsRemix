-    private fun placeCameraSwipeZoneBehindControls(layoutTarget: LayoutTarget) {
+    private fun placeTouchZonesBehindControls(layoutTarget: LayoutTarget) {
         if (layoutTarget != LayoutTarget.MAIN_SCREEN) return
-        val swipeZone = getLayoutComponentView(LayoutComponent.KH_CAMERA_SWIPE_ZONE)?.view ?: return
+
+        // Touch zones may cover a large part of the display. Keep them immediately
+        // above the rendered DS screens but below every ordinary control so an
+        // overlapping button always receives the gesture first.
+        val touchZones = listOf(LayoutComponent.MOVEMENT_STICK, LayoutComponent.KH_CAMERA_SWIPE_ZONE)
+            .mapNotNull { getLayoutComponentView(it)?.view }
         val screenCount = getLayoutComponentViews().count { it.component.isScreen() }
-        removeView(swipeZone)
-        addView(swipeZone, screenCount, swipeZone.layoutParams)
+        touchZones.forEach { removeView(it) }
+        touchZones.forEachIndexed { index, zone ->
+            addView(zone, screenCount + index, zone.layoutParams)
+        }
     }
 

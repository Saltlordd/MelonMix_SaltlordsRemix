     private val autoHideRunnable = Runnable { fadeSoftInputs() }
 
@@ -62,10 +62,13 @@ class RuntimeLayoutView(context: Context, attrs: AttributeSet? = null) : LayoutV
         updateVisibility()
     }
 
-    fun setKhSceneControlsHidden(hidden: Boolean) {
-        if (khSceneControlsHidden == hidden) return
-        khSceneControlsHidden = hidden
-        updateVisibility()
+    fun setKhTouchControlSceneMode(mode: Int) {
+        if (khTouchControlSceneMode == mode) return
+        val previouslyHidden = khSceneHiddenComponents(khTouchControlSceneMode)
+        khTouchControlSceneMode = mode
+        val nowHidden = khSceneHiddenComponents(mode)
+        animateKhSceneControls(nowHidden - previouslyHidden, true)
+        animateKhSceneControls(previouslyHidden - nowHidden, false)
     }
 
     fun toggleSoftInputVisibility() {
@@ -261,14 +264,7 @@ class RuntimeLayoutView(context: Context, attrs: AttributeSet? = null) : LayoutV
             hiddenComponents = LayoutComponent.entries.toList().filterNot { it in controlToggles }
         }
 
-        if (khSceneControlsHidden) {
-            hiddenComponents = (hiddenComponents + listOf(
-                LayoutComponent.BUTTON_KH_X,
-                LayoutComponent.BUTTON_KH_GUARD,
-                LayoutComponent.BUTTON_KH_LOCK_ON,
-                LayoutComponent.BUTTON_L_SHORTCUT_TOGGLE,
-            )).distinct()
-        }
+        hiddenComponents = (hiddenComponents + khSceneHiddenComponents(khTouchControlSceneMode)).distinct()
 
         val visibleComponents = LayoutComponent.entries.filter { !hiddenComponents.contains(it) }
 
@@ -284,7 +280,45 @@ class RuntimeLayoutView(context: Context, attrs: AttributeSet? = null) : LayoutV
         }
     }
 
+    private fun khSceneHiddenComponents(mode: Int): Set<LayoutComponent> = when (mode) {
+        1 -> KH_SCENE_COMPONENTS - LayoutComponent.BUTTON_KH_X
+        2 -> KH_SCENE_COMPONENTS
+        else -> emptySet()
+    }
+
+    private fun animateKhSceneControls(components: Set<LayoutComponent>, hidden: Boolean) {
+        val inputAlpha = (currentRuntimeLayout?.softInputOpacity ?: 100) / 100f
+        components.forEach { component ->
+            val componentView = getLayoutComponentView(component) ?: return@forEach
+            val view = componentView.view
+            view.animate().cancel()
+            if (hidden) {
+                view.animate()
+                    .alpha(0f)
+                    .setDuration(SCENE_CONTROL_FADE_MS)
+                    .withEndAction {
+                        if (component in khSceneHiddenComponents(khTouchControlSceneMode)) view.isVisible = false
+                    }
+                    .start()
+            } else if (isSoftInputVisible) {
+                view.isVisible = true
+                view.alpha = 0f
+                view.animate()
+                    .alpha(inputAlpha * componentView.baseAlpha)
+                    .setDuration(SCENE_CONTROL_FADE_MS)
+                    .start()
+            }
+        }
+    }
+
     private companion object {
         const val AUTO_HIDE_FADE_MS = 300L
+        const val SCENE_CONTROL_FADE_MS = 220L
+        val KH_SCENE_COMPONENTS = setOf(
+            LayoutComponent.BUTTON_KH_X,
+            LayoutComponent.BUTTON_KH_GUARD,
+            LayoutComponent.BUTTON_KH_LOCK_ON,
+            LayoutComponent.BUTTON_L_SHORTCUT_TOGGLE,
+        )
     }
 }

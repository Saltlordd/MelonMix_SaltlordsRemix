+    // Percentage of the safe spare vertical space placed above the 4:3 portrait viewport.
+    // 0 is the highest safe position; 50 is mathematically centred.
+    override fun getKhPortraitScreenPosition(): Flow<Int> {
+        return getOrCreatePreferenceSharedFlow("kh_portrait_screen_position") {
+            preferences.getInt("kh_portrait_screen_position", 20).coerceIn(0, 50)
+        }
+    }
+
     override fun getRenderStrategy(): Flow<RenderStrategy> {

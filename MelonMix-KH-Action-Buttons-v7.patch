@@ -0,0 +1,90 @@
+package me.magnum.melonds.ui.common.input
+
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import android.graphics.Path
+import android.graphics.Typeface
+import android.view.View
+import me.magnum.melonds.domain.model.layout.LayoutComponent
+import kotlin.math.min
+
+class KhActionButtonView(
+    context: Context,
+    private val component: LayoutComponent,
+) : View(context) {
+    private val backgroundPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+        color = Color.argb(135, 0, 0, 0)
+        style = Paint.Style.FILL
+    }
+    private val symbolPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+        color = Color.WHITE
+        strokeWidth = resources.displayMetrics.density * 3f
+        strokeCap = Paint.Cap.ROUND
+        strokeJoin = Paint.Join.ROUND
+    }
+    private val labelPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+        color = Color.WHITE
+        textAlign = Paint.Align.CENTER
+        typeface = Typeface.DEFAULT_BOLD
+    }
+
+    override fun onDraw(canvas: Canvas) {
+        super.onDraw(canvas)
+        val size = min(width, height).toFloat()
+        val cx = width / 2f
+        val cy = height / 2f
+        canvas.drawCircle(cx, cy, size * 0.46f, backgroundPaint)
+
+        when (component) {
+            LayoutComponent.BUTTON_KH_ATTACK -> drawAttack(canvas, cx, cy, size)
+            LayoutComponent.BUTTON_KH_JUMP -> drawJump(canvas, cx, cy, size)
+            LayoutComponent.BUTTON_KH_GUARD -> drawGuard(canvas, cx, cy, size)
+            LayoutComponent.BUTTON_KH_X -> drawLetter(canvas, cx, cy, size, "X")
+            else -> Unit
+        }
+    }
+
+    private fun drawAttack(canvas: Canvas, cx: Float, cy: Float, size: Float) {
+        symbolPaint.style = Paint.Style.STROKE
+        symbolPaint.strokeWidth = size * 0.075f
+        canvas.drawLine(cx - size * 0.19f, cy + size * 0.22f, cx + size * 0.17f, cy - size * 0.20f, symbolPaint)
+        canvas.drawLine(cx - size * 0.25f, cy + size * 0.09f, cx - size * 0.05f, cy + size * 0.27f, symbolPaint)
+        canvas.drawLine(cx + size * 0.10f, cy - size * 0.21f, cx + size * 0.25f, cy - size * 0.21f, symbolPaint)
+        canvas.drawLine(cx + size * 0.19f, cy - size * 0.28f, cx + size * 0.19f, cy - size * 0.13f, symbolPaint)
+    }
+
+    private fun drawJump(canvas: Canvas, cx: Float, cy: Float, size: Float) {
+        symbolPaint.style = Paint.Style.STROKE
+        symbolPaint.strokeWidth = size * 0.065f
+        val path = Path().apply {
+            moveTo(cx - size * 0.23f, cy + size * 0.20f)
+            lineTo(cx, cy - size * 0.22f)
+            lineTo(cx + size * 0.23f, cy + size * 0.20f)
+            moveTo(cx, cy - size * 0.22f)
+            lineTo(cx, cy + size * 0.25f)
+        }
+        canvas.drawPath(path, symbolPaint)
+    }
+
+    private fun drawGuard(canvas: Canvas, cx: Float, cy: Float, size: Float) {
+        symbolPaint.style = Paint.Style.STROKE
+        symbolPaint.strokeWidth = size * 0.055f
+        val path = Path().apply {
+            moveTo(cx, cy - size * 0.27f)
+            lineTo(cx + size * 0.24f, cy - size * 0.15f)
+            lineTo(cx + size * 0.18f, cy + size * 0.16f)
+            lineTo(cx, cy + size * 0.29f)
+            lineTo(cx - size * 0.18f, cy + size * 0.16f)
+            lineTo(cx - size * 0.24f, cy - size * 0.15f)
+            close()
+        }
+        canvas.drawPath(path, symbolPaint)
+    }
+
+    private fun drawLetter(canvas: Canvas, cx: Float, cy: Float, size: Float, letter: String) {
+        labelPaint.textSize = size * 0.48f
+        canvas.drawText(letter, cx, cy - (labelPaint.ascent() + labelPaint.descent()) / 2f, labelPaint)
+    }
+}

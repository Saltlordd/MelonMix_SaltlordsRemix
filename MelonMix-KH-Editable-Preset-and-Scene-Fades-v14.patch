+int PluginKingdomHeartsDays::touchControlSceneMode()
+{
+    if (GameScene == gameScene_InGameWithMap && isCharacterControllable && !isDialogVisible())
+        return 0;
+    // Days uses X for secondary actions such as toggling the status/ability view.
+    if (GameScene == gameScene_InGameMenu || GameScene == gameScene_ConfigMenu)
+        return 1;
+    return 2;

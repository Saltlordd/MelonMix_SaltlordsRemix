@@ -48,7 +48,11 @@ class UILayoutProvider(private val defaultLayoutProvider: DefaultLayoutProvider)
         if (layoutConfiguration == null || variant == null) {
             null
         } else {
-            val layout = getOptimalLayoutForVariant(layoutConfiguration, variant)
+            val layout = if (topScreenOnly && layoutConfiguration.type == LayoutConfiguration.LayoutType.DEFAULT) {
+                defaultLayoutProvider.buildKhDefaultLayout(variant)
+            } else {
+                getOptimalLayoutForVariant(layoutConfiguration, variant)
+            }
             variant to if (topScreenOnly) buildKhTopScreenOnlyLayout(layout, variant) else layout
         }
     }

@@ -0,0 +1,30 @@
+package me.magnum.melonds.ui.emulator.input
+
+import android.view.MotionEvent
+import android.view.View
+import me.magnum.melonds.common.vibration.TouchVibrator
+import me.magnum.melonds.domain.model.Input
+import me.magnum.melonds.ui.common.input.KhShortcutToggleView
+
+class KhShortcutToggleInputHandler(
+    inputListener: IInputListener,
+    enableHapticFeedback: Boolean,
+    touchVibrator: TouchVibrator,
+) : FeedbackInputHandler(inputListener, enableHapticFeedback, touchVibrator) {
+
+    override fun onTouch(view: View, event: MotionEvent): Boolean {
+        val toggleView = view as? KhShortcutToggleView ?: return false
+        if (event.actionMasked != MotionEvent.ACTION_DOWN) return true
+
+        val latched = !toggleView.isLatched
+        toggleView.setLatched(latched)
+        if (latched) {
+            inputListener.onKeyPress(Input.L)
+            performHapticFeedback(view, HapticFeedbackType.KEY_PRESS)
+        } else {
+            inputListener.onKeyReleased(Input.L)
+            performHapticFeedback(view, HapticFeedbackType.KEY_RELEASE)
+        }
+        return true
+    }
+}

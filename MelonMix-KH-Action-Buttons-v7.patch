+package me.magnum.melonds.ui.common.componentbuilders
+
+import android.content.Context
+import android.view.View
+import me.magnum.melonds.domain.model.layout.LayoutComponent
+import me.magnum.melonds.ui.common.LayoutComponentViewBuilder
+import me.magnum.melonds.ui.common.input.KhActionButtonView
+
+class KhActionButtonLayoutComponentViewBuilder(
+    private val component: LayoutComponent,
+) : LayoutComponentViewBuilder() {
+    override fun build(context: Context): View = KhActionButtonView(context, component)
+
+    override fun getAspectRatio() = 1f
+}

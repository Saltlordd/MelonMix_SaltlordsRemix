index 0000000..8f85e95
--- /dev/null
+++ b/app/src/main/java/me/magnum/melonds/ui/emulator/input/KhCameraSwipeInputHandler.kt
@@ -0,0 +1,74 @@
+package me.magnum.melonds.ui.emulator.input
+
+import android.os.Handler
+import android.os.Looper
+import android.view.MotionEvent
+import android.view.View
+import me.magnum.melonds.MelonEmulator
+import kotlin.math.abs
+import kotlin.math.pow
+
+/**
+ * Turns relative drags over an invisible touchpad into short camera-axis pulses.
+ * Relative deltas make every new touch the centre, unlike a fixed virtual stick.
+ */
+class KhCameraSwipeInputHandler : View.OnTouchListener {
+    private val handler = Handler(Looper.getMainLooper())
+    private var pointerId = MotionEvent.INVALID_POINTER_ID
+    private var lastX = 0f
+    private var lastY = 0f
+    private val stopCamera = Runnable { MelonEmulator.setKhCameraAxes(0f, 0f) }
+
+    override fun onTouch(view: View, event: MotionEvent): Boolean {
+        when (event.actionMasked) {
+            MotionEvent.ACTION_DOWN -> {
+                pointerId = event.getPointerId(0)
+                lastX = event.x
+                lastY = event.y
+                stop()
+            }
+            MotionEvent.ACTION_MOVE -> {
+                val index = event.findPointerIndex(pointerId)
+                if (index >= 0) {
+                    val x = event.getX(index)
+                    val y = event.getY(index)
+                    val scale = view.resources.displayMetrics.density * PIXELS_PER_UNIT_DP
+                    val axisX = curve(((x - lastX) / scale).coerceIn(-1f, 1f))
+                    val axisY = curve(((y - lastY) / scale).coerceIn(-1f, 1f))
+                    lastX = x
+                    lastY = y
+
+                    if (abs(axisX) > DEADZONE || abs(axisY) > DEADZONE) {
+                        MelonEmulator.setKhCameraAxes(axisX * MAX_SPEED, axisY * MAX_SPEED)
+                        handler.removeCallbacks(stopCamera)
+                        handler.postDelayed(stopCamera, PULSE_MS)
+                    }
+                }
+            }
+            MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL -> {
+                pointerId = MotionEvent.INVALID_POINTER_ID
+                stop()
+            }
+        }
+        return true
+    }
+
+    private fun curve(value: Float): Float {
+        if (abs(value) < DEADZONE) return 0f
+        val sign = if (value < 0f) -1f else 1f
+        return sign * abs(value).pow(RESPONSE_CURVE)
+    }
+
+    private fun stop() {
+        handler.removeCallbacks(stopCamera)
+        MelonEmulator.setKhCameraAxes(0f, 0f)
+    }
+
+    private companion object {
+        const val PIXELS_PER_UNIT_DP = 48f
+        const val DEADZONE = 0.025f
+        const val RESPONSE_CURVE = 1.25f
+        const val MAX_SPEED = 0.62f
+        const val PULSE_MS = 34L
+    }
+}
